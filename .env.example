NEXT_PUBLIC_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turns:openrelay.metered.ca:443
NEXT_PUBLIC_TURN_USERNAME=openrelayproject
NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject

# ── Flow.cl Payment Gateway ──────────────────────────────────────────────────
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://www.flow.cl/api
# URL where Flow POSTs payment confirmations (your API server)
FLOW_CALLBACK_URL=https://api.uzeed.cl/webhooks/flow/payment
# Flow subscription plan ID (created once via POST /plans/setup)
FLOW_PLAN_ID=UZEED_PRO_MENSUAL

# ── Membership pricing ───────────────────────────────────────────────────────
MEMBERSHIP_PRICE_CLP=4990
MEMBERSHIP_DAYS=30
FREE_TRIAL_DAYS=7

# ── Google OAuth (Sign in with Google — clients only) ───────────────────────
# Create a Web OAuth client at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Dev: http://localhost:3001/auth/google/callback
# Prod: https://api.uzeed.cl/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ── Chaturbate affiliate (server-side only — used by /live-count and /live-feed) ──
# Affiliate campaign code (wm). Never exposed to the frontend.
CHATURBATE_AFFILIATE_WM=Ifv4A

# ── X (Twitter): anuncio automático de perfiles nuevos ───────────────────────
# Credenciales OAuth 1.0a de usuario de la app de UZEED (Developer Portal → Keys
# and tokens). El token de acceso debe ser de la cuenta que publica y tener
# permiso de escritura. Sin credenciales no se publica nada: la cola se llena
# igual y queda auditable.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Interruptor general: "off" corta la publicación sin borrar las credenciales.
X_AUTOPOST=on
# Margen entre el alta y el anuncio, para que el perfil llegue completo y revisado.
X_AUTOPOST_DELAY_MINUTES=30
# Publicaciones por pasada del worker (corre cada 10 minutos).
X_AUTOPOST_BATCH=3
